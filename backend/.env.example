# ─────────────────────────────────────────────────────────────────
#  Karobar backend — copy to .env and fill in
# ─────────────────────────────────────────────────────────────────

APP_NAME=Karobar
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ── Security ─────────────────────────────────────────────────────
# generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=60
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","capacitor://localhost"]

# ── Database ─────────────────────────────────────────────────────
# LOCAL (default):
DATABASE_URL=sqlite+aiosqlite:///./karobar.db
#
# SUPABASE / POSTGRES — nothing else in the app needs to change.
# Use the *pooler* host, not db.<ref>.supabase.co: the direct host is IPv6-only
# and unreachable from most home and office networks.
# Use port 5432 (session mode), not 6543 (transaction mode) — Alembic needs
# prepared statements, which the transaction pooler does not support.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Supabase (needed only for Supabase Storage) ──────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=                # publishable key — client side only
SUPABASE_SERVICE_KEY=             # service_role (secret) — uploads happen server-side
SUPABASE_BUCKET=karobar           # create it as a PRIVATE bucket

# ── AI (Groq — free tier) ────────────────────────────────────────
# Get a key at console.groq.com. Without one the app runs fine; only the
# assistant and bill scanning are switched off.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# gpt-oss-120b and qwen/qwen3.6-27b both call tools reliably and read Roman Urdu.
# Do NOT use llama-3.3-70b-versatile — it fails tool calls with `tool_use_failed`.
AI_MODEL=openai/gpt-oss-120b
AI_FAST_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=4096
AI_EFFORT=medium                  # low | medium | high
AI_ENABLED=true

# ── OTP / SMS ────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true                 # true → OTP returned in response, no SMS sent
SMS_PROVIDER=                     # twilio | msg91 | (blank = disabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Google / Gmail ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
# SMTP fallback when OAuth isn't configured (use a Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Karobar

# ── WhatsApp Cloud API ───────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=karobar-verify-token
WHATSAPP_API_VERSION=v21.0

# ── Storage ──────────────────────────────────────────────────────
STORAGE_BACKEND=local             # local | supabase | s3
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AI=60/minute
